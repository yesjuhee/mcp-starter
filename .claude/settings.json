{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--script",
              "${CLAUDE_PROJECT_DIR}/.claude/skills/tutor/scripts/progress.py",
              "session-context"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--script",
              "${CLAUDE_PROJECT_DIR}/.claude/skills/tutor/scripts/progress.py",
              "guard"
            ]
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run --quiet --script *.claude/skills/tutor/scripts/progress.py *)"
    ]
  }
}
